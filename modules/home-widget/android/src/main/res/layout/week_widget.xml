<?xml version="1.0" encoding="utf-8"?>
<!-- M–S dots for this week (shaded by sets like History), days/week, Start. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/week_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/week_widget_bg"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="12dp"
  android:paddingEnd="10dp">

  <LinearLayout
    android:id="@+id/week_dots"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">
      <TextView
        android:id="@+id/week_l0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="M"
        android:textColor="#888888"
        android:textSize="11sp" />
      <TextView
        android:id="@+id/week_d0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="●"
        android:textColor="#262626"
        android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">
      <TextView
        android:id="@+id/week_l1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="T"
        android:textColor="#888888"
        android:textSize="11sp" />
      <TextView
        android:id="@+id/week_d1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="●"
        android:textColor="#262626"
        android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">
      <TextView
        android:id="@+id/week_l2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="W"
        android:textColor="#888888"
        android:textSize="11sp" />
      <TextView
        android:id="@+id/week_d2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="●"
        android:textColor="#262626"
        android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">
      <TextView
        android:id="@+id/week_l3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="T"
        android:textColor="#888888"
        android:textSize="11sp" />
      <TextView
        android:id="@+id/week_d3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="●"
        android:textColor="#262626"
        android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">
      <TextView
        android:id="@+id/week_l4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="F"
        android:textColor="#888888"
        android:textSize="11sp" />
      <TextView
        android:id="@+id/week_d4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="●"
        android:textColor="#262626"
        android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">
      <TextView
        android:id="@+id/week_l5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="S"
        android:textColor="#888888"
        android:textSize="11sp" />
      <TextView
        android:id="@+id/week_d5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="●"
        android:textColor="#262626"
        android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">
      <TextView
        android:id="@+id/week_l6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="S"
        android:textColor="#888888"
        android:textSize="11sp" />
      <TextView
        android:id="@+id/week_d6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="●"
        android:textColor="#262626"
        android:textSize="18sp" />
    </LinearLayout>

  </LinearLayout>

  <TextView
    android:id="@+id/week_count"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="8dp"
    android:text="0/wk"
    android:textColor="#FFFFFF"
    android:textSize="13sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/week_start"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/week_widget_btn"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp"
    android:text="▶ Start"
    android:textColor="#000000"
    android:textSize="13sp"
    android:textStyle="bold" />
</LinearLayout>
