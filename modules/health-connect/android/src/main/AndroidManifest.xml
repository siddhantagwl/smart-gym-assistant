<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!-- connect-client needs API 26; the module checks the SDK before use. -->
  <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

  <!-- Read-only: the watch (Zepp) writes these, Sadhana shows them per session. -->
  <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
  <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
  <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
  <uses-permission android:name="android.permission.health.READ_EXERCISE" />

  <queries>
    <package android:name="com.google.android.apps.healthdata" />
  </queries>

  <application>
    <!-- Health Connect only shows the permission dialog to apps that explain
         their data use: rationale screen (Android 13-) + permission-usage
         alias (Android 14+). -->
    <activity
      android:name="expo.modules.healthconnect.HealthRationaleActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
      </intent-filter>
    </activity>
    <activity-alias
      android:name="expo.modules.healthconnect.ViewPermissionUsageActivity"
      android:exported="true"
      android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
      android:targetActivity="expo.modules.healthconnect.HealthRationaleActivity">
      <intent-filter>
        <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
        <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
      </intent-filter>
    </activity-alias>
  </application>
</manifest>
